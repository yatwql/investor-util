#!/bin/sh
# git pre-commit hook — 提交门禁自动化
#
# 1) 任务编号（plan-/rf-）全局一致性检查
#    提交 plan.md / review-findings.md 时校验「编号源」标记（plan-next / rf-next）
#    是否与全部历史归档无冲突，防止新增编号撞历史编号。
#
# 2) 统计快照自动同步（check-doc-drift --sync）
#    提交涉及 managements/ 文档或测试代码时，把 folders.md 统计表的
#    登记数字自动回写为实测值并加入暂存区 —— 治理「人工同步必漏」的
#    最高频 CI 红源；同步后仍不一致（需人工判断的漂移）则中止提交。
#
# 依赖 Python 在 PATH 或项目 .venv 中。需启用 core.hooksPath（install-hooks.sh）。

set -e

# 优先项目虚拟环境解释器（CLAUDE.md：Python 命令一律走 .venv）。
# Windows 布局（.venv/Scripts/python.exe）优先：裸 python/python3 会命中系统
# 解释器，缺 pandas 等依赖且 pytest 收集口径不同（实测 7964 vs 8173），
# 曾致 pre-commit 把错误用例数回写进 folders.md。
PY_CMD=""
if [ -x ".venv/Scripts/python.exe" ]; then
    PY_CMD=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PY_CMD=".venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PY_CMD="python"
elif command -v python3 >/dev/null 2>&1; then
    PY_CMD="python3"
fi

CHANGED=$(git diff --cached --name-only 2>/dev/null || true)

# ── 1) 任务编号一致性（仅提交涉及编号管理文档时才校验）
if echo "$CHANGED" | grep -qE '(^|/)plan\.md$|(^|/)review-findings\.md$'; then
    echo "[..] pre-commit: 校验任务编号一致性（涉及编号管理文档）"
    if ! "$PY_CMD" scripts/check-task-numbering.py --ci; then
        echo "[ERR] pre-commit: 任务编号与历史归档冲突，请修正 plan-next / rf-next 标记后重试" >&2
        exit 1
    fi
    echo "[OK] pre-commit: 任务编号一致性通过"
fi

# ── 2) 统计快照自动同步（涉及 managements/ 或测试代码时）
if echo "$CHANGED" | grep -qE '^docs-stm/managements/|^src/test/'; then
    echo "[..] pre-commit: 统计快照同步（folders.md 数字自动回写）"
    if ! "$PY_CMD" scripts/check-doc-drift.py --sync --ci; then
        echo "[ERR] pre-commit: 文档与实现仍有不一致（同步已回写统计数字，其余项目请按提示修正）" >&2
        exit 1
    fi
    echo "[OK] pre-commit: 统计快照同步完成"
fi

exit 0
