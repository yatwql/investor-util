#!/bin/sh
# git pre-commit hook — 提交门禁自动化
#
# 1) 八守护全量（与 P0/P2 门禁清单、CI guards job 同源；check-doc-drift 第 16 项
#    「守护清单同源」把本文件与 developer-guide / ci.yml / CLAUDE.md / testplan.md
#    五处的 `scripts/check-*.py --ci` 引用集合两两比对，漏改任一处即报）
#    - check-code-traces / check-doc-traces：代码与文档历史痕迹
#    - check-task-numbering：任务编号（plan-/rf-）全局一致性
#    - check-semantic-index：语义命名索引正反向校验
#    - check-doc-drift：文档与实现一致性（统计快照自动回写 folders.md 并 git add）
#    - check-test-redundancy：测试冗余与无效用例
#    - check-requirement-trace：需求 ID ↔ 验证载体追溯
#    - check-version-consistency：版本号 13 处一致
#    约 4~5 秒；任一 finding 即中止提交。此前本钩子仅条件触发其中 3 项，
#    曾致 README 痕迹与 folders 行数漂移在本地放行、到 CI 才红。
#    dev-verify（P0 单测）不入钩子，仍为提交前手动纪律 + CI 兜底。
#
# 依赖 Python 在 PATH 或项目 .venv 中。需启用 core.hooksPath（install-hooks.sh）。

set -e

# 优先项目虚拟环境解释器（CLAUDE.md：Python 命令一律走 .venv）。
# Windows 布局（.venv/Scripts/python.exe）优先：裸 python/python3 会命中系统
# 解释器，缺 pandas 等依赖且 pytest 收集口径不同（实测 7964 vs 8173），
# 曾致 pre-commit 把错误用例数回写进 folders.md。
PY_CMD=""
if [ -x ".venv/Scripts/python.exe" ]; then
    PY_CMD=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PY_CMD=".venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PY_CMD="python"
elif command -v python3 >/dev/null 2>&1; then
    PY_CMD="python3"
fi

CHANGED=$(git diff --cached --name-only 2>/dev/null || true)
GUARD_FAILED=""

# ── 1) 统计快照同步 + 文档漂移（涉及 managements/ 或 src/test/ 时 --sync 回写
#      并由脚本自行 git add；其余提交纯 --ci 校验，README/手册漂移同样拦截）
if echo "$CHANGED" | grep -qE '^docs-stm/managements/|^src/test/'; then
    echo "[..] pre-commit: 统计快照同步 + 文档漂移（check-doc-drift --sync）"
    if ! "$PY_CMD" scripts/check-doc-drift.py --sync --ci; then
        GUARD_FAILED="$GUARD_FAILED check-doc-drift"
    fi
else
    echo "[..] pre-commit: scripts/check-doc-drift.py --ci"
    if ! "$PY_CMD" scripts/check-doc-drift.py --ci; then
        GUARD_FAILED="$GUARD_FAILED check-doc-drift"
    fi
fi

# ── 2) 其余七个守护（无条件全量，与 CI guards job 逐步同源）
echo "[..] pre-commit: 七守护全量校验"
if ! "$PY_CMD" scripts/check-code-traces.py --ci; then GUARD_FAILED="$GUARD_FAILED check-code-traces"; fi
if ! "$PY_CMD" scripts/check-doc-traces.py --ci; then GUARD_FAILED="$GUARD_FAILED check-doc-traces"; fi
if ! "$PY_CMD" scripts/check-task-numbering.py --ci; then GUARD_FAILED="$GUARD_FAILED check-task-numbering"; fi
if ! "$PY_CMD" scripts/check-semantic-index.py --ci; then GUARD_FAILED="$GUARD_FAILED check-semantic-index"; fi
if ! "$PY_CMD" scripts/check-test-redundancy.py --ci; then GUARD_FAILED="$GUARD_FAILED check-test-redundancy"; fi
if ! "$PY_CMD" scripts/check-requirement-trace.py --ci; then GUARD_FAILED="$GUARD_FAILED check-requirement-trace"; fi
if ! "$PY_CMD" scripts/check-version-consistency.py --ci; then GUARD_FAILED="$GUARD_FAILED check-version-consistency"; fi

if [ -n "$GUARD_FAILED" ]; then
    echo "[ERR] pre-commit: 守护未通过:$GUARD_FAILED" >&2
    echo "       按上方输出提示修复后重试（清单与 P0 门禁 / CI guards job 同源）" >&2
    exit 1
fi

echo "[OK] pre-commit: 八守护全量通过"
exit 0
