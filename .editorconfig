# EditorConfig — 项目编码规则（随仓库走，跨机器生效）
# 支持 EditorConfig 的编辑器（VS Code、Vim、IntelliJ 等）保存文件时自动套用。
root = true

# 默认 UTF-8（无 BOM），全部文本文件统一
[*]
charset = utf-8

# Windows PowerShell 脚本必须 UTF-8 with BOM + CRLF：
# 无 BOM 时 Windows PowerShell 5.1 按 ANSI/GBK 误读 UTF-8 中文注释，
# 导致解析崩溃（"字符串缺少终止符"）。编辑后必须保持 BOM+CRLF 不变。
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

# requirements.txt 含中文注释时必须 UTF-8 with BOM：
# 无 BOM 时中文 Windows（cp936 locale）上 pip <= 24.x 的 auto_decode 按「BOM →
# PEP263 cookie → locale 编码」次序解码，最后一档回退 cp936 并报 UnicodeDecodeError
# （'gbk' codec can't decode byte 0xac），启动脚本装依赖中断（pip >= 25 起默认 UTF-8，
# 故该缺陷只在旧 pip 上暴露）。编辑后必须保留 BOM。
[requirements.txt]
charset = utf-8-bom
