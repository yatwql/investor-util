{
  // LLM Provider 多链配置
  // 主：DeepSeek（通过 claude 兼容端点）/ 辅：Gemini

  "strategy": "priority",
  "preferred_providers": {},
  "providers": [
    {
      "name": "deepseek-main",
      "provider": "claude",
      "credentials_ref": "deepseek-main",
      "priority": 10,
      "timeout": 120
    },
    {
      "name": "gemini-fallback",
      "provider": "gemini",
      "credentials_ref": "gemini-fb",
      "priority": 20,
      "timeout": 60,
      "proxy_preferred": true
    }
  ]
}
